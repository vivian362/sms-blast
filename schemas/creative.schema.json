{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generated ad creative",
  "type": "object",
  "required": [
    "platform",
    "project",
    "campaign",
    "group",
    "creative",
    "validation"
  ],
  "properties": {
    "platform": {
      "type": "string",
      "enum": ["meta", "google"]
    },
    "project": {
      "type": "object",
      "required": ["name", "generated_at_utc"],
      "properties": {
        "name": {"type": "string"},
        "generated_at_utc": {"type": "string"}
      },
      "additionalProperties": true
    },
    "campaign": {
      "type": "object",
      "required": ["name", "objective", "audience"],
      "properties": {
        "name": {"type": "string"},
        "objective": {"type": "string"},
        "audience": {"type": "string"}
      },
      "additionalProperties": true
    },
    "group": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "creative": {
      "type": "object",
      "required": [
        "asset_name",
        "hook",
        "value_prop",
        "primary_text",
        "headline",
        "description",
        "cta",
        "variants"
      ],
      "properties": {
        "asset_name": {"type": "string"},
        "hook": {"type": "string"},
        "value_prop": {"type": "string"},
        "primary_text": {"type": "string"},
        "headline": {"type": "string"},
        "description": {"type": "string"},
        "cta": {"type": "string"},
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "text"],
            "properties": {
              "label": {"type": "string"},
              "text": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["policy_notes", "disclaimers"],
      "properties": {
        "policy_notes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "disclaimers": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
